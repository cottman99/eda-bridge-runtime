{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cottman99.github.io/eda-bridge-runtime/schemas/experience-asset-v1.schema.json",
  "title": "EDA Bootstrap Experience Asset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "asset_version", "id", "kind", "status", "summary",
    "intents", "tags", "applies_to", "prerequisites", "recommendation",
    "steps", "failure_signals", "validation", "official_refs",
    "evidence_refs", "confidence", "last_verified", "supersedes"
  ],
  "properties": {
    "schema_version": {"const": "eda.experience-asset/v1"},
    "asset_version": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["intuition", "action_pattern", "workflow", "anti_pattern"]},
    "status": {"enum": ["candidate", "validated", "preferred", "deprecated"]},
    "summary": {"type": "string", "minLength": 1},
    "intents": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "applies_to": {"type": "object"},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "recommendation": {"type": "string"},
    "steps": {"type": "array", "items": {"type": "string"}},
    "failure_signals": {"type": "array", "items": {"type": "string"}},
    "validation": {"type": "object"},
    "official_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "last_verified": {"type": "string", "format": "date"},
    "supersedes": {"type": "array", "items": {"type": "string"}}
  }
}
