{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cottman99/eda-bridge-runtime/native-program-v1.schema.json",
  "title": "Governed official EDA native program v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime",
    "mode",
    "effect",
    "program",
    "scope",
    "transaction",
    "validation",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "eda.native-program/v1"
    },
    "program_id": {
      "$ref": "#/$defs/identifier",
      "description": "Optional caller identifier. When omitted, trusted Runtime materializes a deterministic program-<sha256> identifier from the normalized request, excluding derived fingerprint fields."
    },
    "runtime": {
      "$ref": "#/$defs/identifier"
    },
    "mode": {
      "enum": [
        "live",
        "background",
        "offline"
      ]
    },
    "effect": {
      "enum": [
        "observe",
        "mutate"
      ]
    },
    "program": {
      "$ref": "#/$defs/program"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_kind",
        "selectors",
        "read_paths",
        "write_paths",
        "artifacts"
      ],
      "properties": {
        "resource_kind": {
          "$ref": "#/$defs/identifier"
        },
        "selectors": {
          "type": "object",
          "maxProperties": 32
        },
        "read_paths": {
          "$ref": "#/$defs/paths"
        },
        "write_paths": {
          "$ref": "#/$defs/paths"
        },
        "artifacts": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "source_fingerprints",
        "fresh_reopen",
        "promotion"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "none",
            "adapter_staging",
            "vendor_transaction"
          ]
        },
        "source_fingerprints": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "fresh_reopen": {
          "type": "boolean"
        },
        "promotion": {
          "enum": [
            "none",
            "on_validation"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "required_artifacts"
      ],
      "properties": {
        "program": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/program"
            }
          ]
        },
        "required_artifacts": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_output_bytes"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "source"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Optional caller assertion. Trusted Runtime always recomputes this derived field from the exact UTF-8 source and rejects a supplied mismatch."
        }
      }
    },
    "paths": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "effect": {
            "const": "observe"
          }
        },
        "required": [
          "effect"
        ]
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "artifacts": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
